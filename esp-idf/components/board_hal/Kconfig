menu "QNOB Hardware Configuration"

    choice QNOB_HARDWARE_TARGET
        prompt "Target Hardware Platform"
        default QNOB_HW_ESP32S3_LCD_128
        help
            Select the target hardware platform for QNOB.

        config QNOB_HW_ESP32S3_LCD_128
            bool "ESP32-S3 with 1.28\" GC9A01 LCD (240x240)"
            depends on IDF_TARGET_ESP32S3
            help
                Waveshare ESP32-S3-Touch-LCD-1.28 board with GC9A01 round LCD display.

        config QNOB_HW_ESP32S3_AMOLED_175
            bool "ESP32-S3 with 1.75\" AMOLED (CO5300 QSPI, 466x466)"
            depends on IDF_TARGET_ESP32S3
            help
                Waveshare ESP32-S3-Touch-AMOLED-1.75 board using the CO5300-compatible
                QSPI AMOLED path and CST9217 capacitive touch controller.

        config QNOB_HW_ESP32C6_AMOLED_143
            bool "ESP32-C6 with 1.43\" AMOLED (SH8601 QSPI, 466x466)"
            depends on IDF_TARGET_ESP32C6
            help
                Waveshare ESP32-C6-Touch-AMOLED-1.43 board using the SH8601-compatible QSPI AMOLED path.
    endchoice

    choice QNOB_DISPLAY_ROTATION
        prompt "Display Rotation (clockwise)"
        default QNOB_DISPLAY_ROTATION_270 if QNOB_HW_ESP32S3_AMOLED_175
        default QNOB_DISPLAY_ROTATION_0
        help
            Logical display rotation applied by the firmware. Use this to correct
            board-specific panel orientation mismatches. On the current AMOLED
            backends, 90 and 270 degree rotations are handled by LVGL software
            rotation instead of panel-driver axis swapping.

        config QNOB_DISPLAY_ROTATION_0
            bool "0 degrees"

        config QNOB_DISPLAY_ROTATION_90
            bool "90 degrees"

        config QNOB_DISPLAY_ROTATION_180
            bool "180 degrees"

        config QNOB_DISPLAY_ROTATION_270
            bool "270 degrees"
    endchoice

    choice QNOB_TOUCH_ROTATION
        prompt "Touch Rotation (clockwise)"
        default QNOB_TOUCH_ROTATION_0
        help
            Rotation applied to raw touch coordinates before gesture detection
            and screen interaction logic. Use this when the touch sensor wiring
            does not match the final logical display orientation.

        config QNOB_TOUCH_ROTATION_0
            bool "0 degrees"

        config QNOB_TOUCH_ROTATION_90
            bool "90 degrees"

        config QNOB_TOUCH_ROTATION_180
            bool "180 degrees"

        config QNOB_TOUCH_ROTATION_270
            bool "270 degrees"
    endchoice

    config QNOB_TOUCH_MIRROR_X
        bool "Mirror Touch X Axis"
        default n
        help
            Mirror the transformed touch X coordinate across the visible screen.
            Leave disabled unless the touch controller still reports left/right
            reversed after applying touch rotation.

    config QNOB_TOUCH_MIRROR_Y
        bool "Mirror Touch Y Axis"
        default n
        help
            Mirror the transformed touch Y coordinate across the visible screen.
            Leave disabled unless the touch controller still reports up/down
            reversed after applying touch rotation.

    config QNOB_ENABLE_TOUCH
        bool "Enable Touch Panel"
        default y
        help
            Enable the target-specific capacitive touch panel
            (CST816S on the 1.28 S3 board, CST9217 on the 1.75 S3 AMOLED board,
            FT6x36-compatible on the C6 AMOLED board).

    config QNOB_ENABLE_IMU
        bool "Enable IMU Sensor"
        default n
        help
            Enable the QMI8658 IMU sensor for motion detection.

    config QNOB_ENABLE_KNOB_UART
        bool "Enable Knob UART Communication"
        default n if QNOB_HW_ESP32C6_AMOLED_143
        default y
        help
            Enable UART communication with the external knob controller.
            Off by default on the ESP32-C6 AMOLED 1.43 because its mapped
            pins (GPIO 1/2) collide with the TCA9554 interrupt line and
            PWR_KEY; enable it only after remapping those pins.

    config QNOB_KNOB_BAUD_RATE
        int "Knob UART Baud Rate"
        default 9600
        depends on QNOB_ENABLE_KNOB_UART
        help
            Baud rate for UART communication with knob controller.

    config QNOB_ENABLE_DEEP_SLEEP
        bool "Enable Deep Sleep"
        default y
        help
            Enable deep sleep mode for power saving.

    config QNOB_INACTIVITY_TIMEOUT_SEC
        int "Inactivity Timeout (seconds)"
        default 30
        depends on QNOB_ENABLE_DEEP_SLEEP
        help
            Time in seconds before entering sleep mode due to inactivity.

    config QNOB_WIFI_CONNECT_TIMEOUT_SEC
        int "WiFi Connection Timeout (seconds)"
        default 10
        help
            Maximum time to wait for WiFi connection.

endmenu
