menu "QNOB Application Configuration"

    config QNOB_DEVICE_NAME
        string "Default Device Name"
        default "QNOB"
        help
            Default name for the device, used for MQTT client ID and display.

    config QNOB_WIFI_SSID
        string "Default WiFi SSID"
        default ""
        help
            Default WiFi SSID for initial connection.

    config QNOB_WIFI_PASSWORD
        string "Default WiFi Password"
        default ""
        help
            Default WiFi password for initial connection.

    config QNOB_MQTT_BROKER_URL
        string "Default MQTT Broker URL"
        default ""
        help
            Default MQTT broker URL (e.g., mqtt://broker.example.com)

    config QNOB_MQTT_BROKER_PORT
        int "Default MQTT Broker Port"
        default 1883
        help
            Default MQTT broker port.

    config QNOB_LOG_LEVEL
        int "Log Level (0=None, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Verbose)"
        default 3
        range 0 5
        help
            Set the logging verbosity level.

    config QNOB_MODEL_TRACE
        bool "Model trace: log every drain and each changed model (MDL-32)"
        default n
        help
            Debug aid for the MVC refactor. One log line per display-task drain plus one per
            committed model, and a counter of model writes observed from any other task.

    config QNOB_UTC_OFFSET_MINUTES
        int "Clock offset from UTC in minutes (no DST)"
        default 180
        range -840 840
        help
            The INFO clock shows UTC plus this offset. Daylight saving is not applied; see
            dev_notes/phase1-log.md (NET-07) for the decision.

    config QNOB_NTP_SERVER_1
        string "Primary NTP server"
        default "pool.ntp.org"

    config QNOB_NTP_SERVER_2
        string "Secondary NTP server"
        default "time.nist.gov"

    config QNOB_WEATHER_API_KEY
        string "OpenWeatherMap API key"
        default ""
        help
            Empty means the weather fetch is disabled and logged as unconfigured. Keep the real
            key in sdkconfig.defaults.local, never in a tracked file.

    config QNOB_WEATHER_CITY
        string "Weather city"
        default "Istanbul"

    config QNOB_WEATHER_COUNTRY
        string "Weather country code"
        default "tr"

endmenu
