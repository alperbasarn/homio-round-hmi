# Bench-local sdkconfig overlay - copy to sdkconfig.defaults.local (untracked) and fill in.
# build-variant.{sh,ps1} append it to SDKCONFIG_DEFAULTS automatically when the file exists.
CONFIG_QNOB_WIFI_SSID="your-ssid"
CONFIG_QNOB_WIFI_PASSWORD="your-password"
# NET-28: the weather key lives here too (rotate the leaked one first, see dev_notes/credential-rotation.md)
CONFIG_QNOB_WEATHER_API_KEY="your-openweathermap-key"
