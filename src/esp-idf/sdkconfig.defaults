# QNOB Screen Default Configuration
# Common settings for all targets

# Enable C++ exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# FreeRTOS settings
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Increase Timer Service task stack — timer callbacks (e.g. BootGuard) may
# indirectly call NVS or other stack-heavy functions via task notifications.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
# Increase system event loop task stack — WiFi event handlers call into
# ConnectivityManager and std::string ops which overflow the 2304-byte default.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# SPI RAM (PSRAM) - if available
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# WiFi settings
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# Bluetooth LE HID + BLE serial
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
# CONFIG_BT_BLE_50_FEATURES_SUPPORTED is not set
# CONFIG_BT_CLASSIC_ENABLED is not set

# LWIP settings
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

# NVS
CONFIG_NVS_ENCRYPTION=n

# FATFS (required for long media folder/file names on SD card)
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
# Use 512-byte sectors to match SD card physical sector size
CONFIG_FATFS_SECTOR_512=y
# CONFIG_FATFS_SECTOR_4096 is not set

# LVGL
CONFIG_LV_BUILD_EXAMPLES=n
# LVGL allocates from the IDF heap (bench finding 2026-09-12, dev_notes/phase1-log.md). The built-in pool was 64 KB of internal RAM and the
# INFO screen at 466 px asks lv_draw_sw_rect for a 47 KB shadow corner buffer (290 px disc,
# 9 px shadow: (145+9)^2 x 2 bytes); the failed allocation tripped LV_ASSERT_MALLOC, whose default
# handler is while(1), so the display task spun with a black screen and IDLE0 starved the task
# watchdog. With malloc the S3 boards place blocks above 16 KB in PSRAM and the C6 uses its heap.
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEM_BUF_MAX_NUM=32
CONFIG_LV_USE_QRCODE=n
# Built-in Montserrat sizes the ported main screens use (64/72/96 are custom fonts in ui/fonts).
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# Draw caches as main tuned them for these screens (shadow size cached, circle radii cached).
CONFIG_LV_SHADOW_CACHE_SIZE=16
CONFIG_LV_CIRCLE_CACHE_SIZE=32
# LVGL errors and failed asserts print before the handler runs (they were silent).
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_ERROR=y
CONFIG_LV_LOG_PRINTF=y


# LVGL theme (UIX-02 / D11): dark default so an un-styled object never paints a light rectangle,
# no press-grow and no style transitions on a single-core renderer. REFR_PERIOD stays at 30.
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_THEME_DEFAULT_GROW=n
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=0
