# Build, publish and bench output. The build scripts write out-of-tree builds and the generated
# sdkconfig.<variant> files under helpers/; published images go to binaries/ (OTA under
# binaries/ota); the host tests and the bench scripts write under helpers/ too.
helpers/
binaries/
Binaries/
/OTA/
build_s3_amoled175/

# Generated by ESP-IDF / the component manager (BLD-01). One lock per target is committed
# (dependencies.lock.<target>, BLD-04); a bare dependencies.lock is never.
src/esp-idf/NUL
src/esp-idf/build/
src/esp-idf/sdkconfig
src/esp-idf/sdkconfig.old
src/esp-idf/sdkconfig.pre-*
src/esp-idf/managed_components/
src/esp-idf/dependencies.lock
src/esp-idf/sdkconfig.defaults.local
src/esp-idf/ota/

